@model InventoryManagement.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary-custom">Dashboard</h1>
</div>
<div class="row g-3">
    <div class="col-md-3">
        <div class="card card-kpi shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Products</h6>
                <h2>@(Model?.ProductCount ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-kpi shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Customers</h6>
                <h2>@(Model?.CustomerCount ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-kpi shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Today's Quotations</h6>
                <h2>@(Model?.TodaysQuotationCount ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-kpi shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Pending (Valid)</h6>
                <h2>@(Model?.PendingQuotationCount ?? 0)</h2>
            </div>
        </div>
    </div>
</div>
<div class="mt-4">
    <a asp-controller="Quotations" asp-action="Create" class="btn btn-primary me-2">New Quotation</a>
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary me-2">Browse Products</a>
    <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">Company Settings</a>
</div>
