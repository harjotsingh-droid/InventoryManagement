@model InventoryManagement.Web.Models.SettingsFormViewModel
@{
    ViewData["Title"] = "Company Settings";
}
<h1>Company Settings</h1>
<p class="text-muted">Changes here drive PDF branding and the UI accent color.</p>
<form asp-action="Index" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <h4 class="mt-3">Company Profile</h4>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="PinCode" class="form-label"></label>
            <input asp-for="PinCode" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="GstNumber" class="form-label">GSTIN</label>
            <input asp-for="GstNumber" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="PanNumber" class="form-label">PAN</label>
            <input asp-for="PanNumber" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Mobile" class="form-label"></label>
            <input asp-for="Mobile" class="form-control" />
        </div>
    </div>

    <h4 class="mt-4">Branding & Documents</h4>
    <div class="mb-3">
        <label asp-for="PrimaryColor" class="form-label">Primary Color (hex, e.g. #2563eb)</label>
        <input asp-for="PrimaryColor" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="InvoiceTerms" class="form-label">Invoice / Quotation Terms</label>
        <textarea asp-for="InvoiceTerms" class="form-control" rows="4"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="InvoiceFooter" class="form-label">Invoice Footer</label>
        <textarea asp-for="InvoiceFooter" class="form-control" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Settings</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
