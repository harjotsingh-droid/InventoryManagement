@model IEnumerable<InventoryManagement.Application.DTOs.ProductDto>
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a asp-action="Create" class="btn btn-primary">Add Product</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, SKU, or barcode" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Barcode</th>
                <th class="text-end">Price</th>
                <th class="text-end">GST %</th>
                <th class="text-end">Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Sku</td>
                <td>@item.Barcode</td>
                <td class="text-end">@item.SellingPrice.ToString("0.00")</td>
                <td class="text-end">@item.GstPercent</td>
                <td class="text-end">@item.CurrentStock</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
