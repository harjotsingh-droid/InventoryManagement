@model InventoryManagement.Application.DTOs.QuotationDto
@{
    ViewData["Title"] = Model.QuotationNumber;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.QuotationNumber</h1>
    <a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-primary" target="_blank">Download PDF</a>
</div>
<div class="row mb-4">
    <div class="col-md-6">
        <p><strong>Customer:</strong> @Model.CustomerName</p>
        <p><strong>Date:</strong> @Model.QuotationDate.ToString("dd MMM yyyy")</p>
        <p><strong>Valid Until:</strong> @Model.ValidUntil.ToString("dd MMM yyyy")</p>
    </div>
    <div class="col-md-6 text-md-end">
        <p><strong>Subtotal:</strong> @Model.SubTotal.ToString("0.00")</p>
        <p><strong>Tax:</strong> @Model.TaxAmount.ToString("0.00")</p>
        @if (Model.DiscountAmount > 0)
        {
            <p><strong>Discount:</strong> -@Model.DiscountAmount.ToString("0.00")</p>
        }
        <p><strong>Total:</strong> @Model.TotalAmount.ToString("0.00")</p>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Disc %</th>
                <th class="text-end">GST %</th>
                <th class="text-end">Line Total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var line in Model.Lines)
        {
            <tr>
                <td>@line.ProductName (@line.ProductSku)</td>
                <td class="text-end">@line.Quantity.ToString("0.##")</td>
                <td class="text-end">@line.UnitPrice.ToString("0.00")</td>
                <td class="text-end">@line.DiscountPercent</td>
                <td class="text-end">@line.GstPercent</td>
                <td class="text-end">@line.TotalAmount.ToString("0.00")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="mt-3">
        <strong>Notes:</strong>
        <p>@Model.Notes</p>
    </div>
}
<a asp-action="Index" class="btn btn-link">Back to list</a>
